
{
  "openapi": "3.0.3",
  "info": {
    "title": "Flock Energy API",
    "description": "REST API for meter and distribution transformer information, including meter location and energy consumption.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local development server"
    }
  ],
  "tags": [
    {
      "name": "Meters",
      "description": "Meter information, location and consumption"
    },
    {
      "name": "Transformers",
      "description": "Distribution transformer information and associated meters"
    }
  ],
  "paths": {
    "/api/meters": {
      "get": {
        "tags": ["Meters"],
        "summary": "List and search meters",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Filter meters by installation status"
          },
          {
            "name": "search",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Search meter records"
          }
        ],
        "responses": {
          "200": {
            "description": "Meter records retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Meter"
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/api/meters/{meterId}": {
      "get": {
        "tags": ["Meters"],
        "summary": "Get a meter by ID",
        "parameters": [
          {
            "$ref": "#/components/parameters/MeterId"
          }
        ],
        "responses": {
          "200": {
            "description": "Meter retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Meter"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/api/meters/{meterId}/geo": {
      "get": {
        "tags": ["Meters"],
        "summary": "Get meter geographic coordinates",
        "parameters": [
          {
            "$ref": "#/components/parameters/MeterId"
          }
        ],
        "responses": {
          "200": {
            "description": "Geographic data retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "latitude": {
                          "type": "string",
                          "example": "26.822136543835608"
                        },
                        "longitude": {
                          "type": "string",
                          "example": "75.90718190602279"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "502": {
            "$ref": "#/components/responses/UpstreamError"
          }
        }
      }
    },
    "/api/meters/{meterId}/consumption": {
      "get": {
        "tags": ["Meters"],
        "summary": "Get meter energy consumption readings",
        "parameters": [
          {
            "$ref": "#/components/parameters/MeterId"
          }
        ],
        "responses": {
          "200": {
            "description": "Consumption readings retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "timestamp": {
                            "type": "string",
                            "description": "Timestamp of the reading"
                          },
                          "kwh": {
                            "type": "string"
                          },
                          "kvah": {
                            "type": "string"
                          },
                          "voltR": {
                            "type": "string"
                          }
                        },
                        "additionalProperties": true
                      }
                    }
                  }
                }
              }
            }
          },
          "502": {
            "$ref": "#/components/responses/UpstreamError"
          }
        }
      }
    },
    "/api/transformers": {
      "get": {
        "tags": ["Transformers"],
        "summary": "List and search transformers",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            },
            "description": "Upstream page number"
          },
          {
            "name": "search",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Search transformer code, name or feeder code"
          }
        ],
        "responses": {
          "200": {
            "description": "Transformer records retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Transformer"
                      }
                    },
                    "total": {
                      "type": "integer"
                    },
                    "page": {
                      "type": "integer"
                    },
                    "pageSize": {
                      "type": "integer"
                    },
                    "count": {
                      "type": "integer",
                      "description": "Number of records returned after filtering"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "502": {
            "$ref": "#/components/responses/UpstreamError"
          }
        }
      }
    },
    "/api/transformers/{transformerId}": {
      "get": {
        "tags": ["Transformers"],
        "summary": "Get a transformer by ID",
        "parameters": [
          {
            "$ref": "#/components/parameters/TransformerId"
          }
        ],
        "responses": {
          "200": {
            "description": "Transformer retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Transformer"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "502": {
            "$ref": "#/components/responses/UpstreamError"
          }
        }
      }
    },
    "/api/transformers/{transformerId}/meters": {
      "get": {
        "tags": ["Transformers"],
        "summary": "List meters associated with a transformer",
        "description": "Matches the transformer's code against the dtCode field in the local meter export.",
        "parameters": [
          {
            "$ref": "#/components/parameters/TransformerId"
          }
        ],
        "responses": {
          "200": {
            "description": "Associated meters retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["transformerId", "count", "data"],
                  "properties": {
                    "transformerId": {
                      "type": "string",
                      "example": "DT-001"
                    },
                    "count": {
                      "type": "integer",
                      "example": 10
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Meter"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "MeterId": {
        "name": "meterId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        },
        "description": "Unique meter identifier"
      },
      "TransformerId": {
        "name": "transformerId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        },
        "description": "Distribution transformer code"
      }
    },
    "schemas": {
      "Meter": {
        "type": "object",
        "properties": {
          "meterId": {
            "type": "string",
            "example": "J100000"
          },
          "serialNo": {
            "type": "string"
          },
          "make": {
            "type": "string"
          },
          "phaseType": {
            "type": "string"
          },
          "installStatus": {
            "type": "string"
          },
          "installType": {
            "type": "string"
          },
          "build": {
            "type": "string"
          },
          "dtCode": {
            "type": "string",
            "example": "DT-001"
          },
          "hierarchy": {
            "type": "object",
            "additionalProperties": true
          },
          "geo": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      },
      "Transformer": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "DT-001"
          },
          "name": {
            "type": "string",
            "example": "Malviya Nagar DT 1"
          },
          "feederCode": {
            "type": "string",
            "example": "F-001"
          },
          "capacityKva": {
            "type": "number",
            "example": 100
          }
        },
        "additionalProperties": true
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "details": {},
          "upstreamStatus": {
            "type": "integer",
            "nullable": true
          }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Invalid request parameters",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "NotFound": {
        "description": "Requested resource not found",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "InternalError": {
        "description": "Internal server error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "UpstreamError": {
        "description": "Upstream portal request failed",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    }
  }
}
